{
  "name": "neon-daw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NeonDAW — a complete DAW that runs entirely in your browser: step-sequenced drums, piano roll, effect-laden mixer, song arrangement, generative tracks and offline WAV export. 100% client-side.",
  "keywords": [
    "daw",
    "music",
    "web-audio",
    "tone-js",
    "react",
    "typescript",
    "music-production",
    "synthesizer",
    "step-sequencer",
    "piano-roll"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^15.0.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
